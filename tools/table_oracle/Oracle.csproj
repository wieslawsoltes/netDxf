<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><Reference Include="ACadSharp"><HintPath>$(ACadSharpAssembly)</HintPath></Reference></ItemGroup>
  <Target Name="RequirePinnedReader" BeforeTargets="ResolveReferences" Condition="!Exists('$(ACadSharpAssembly)')"><Error Text="Set ACadSharpAssembly to the pinned ACadSharp net8.0 DLL; see README.md." /></Target>
</Project>
