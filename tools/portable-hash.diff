diff --git a/netDxf/GTE/GVector.cs b/netDxf/GTE/GVector.cs
index 97ab1ec4526a339a9c5995348a90b2a0aae19065..37b41b8a5af4ea218e1d4723ccc69d9f877a0064 100644
