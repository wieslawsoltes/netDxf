<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NetDxfAssembly Condition="'$(NetDxfAssembly)' == ''">../../netDxf/bin/Debug/net8.0/netDxf.netstandard.dll</NetDxfAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="netDxf.netstandard"><HintPath>$(NetDxfAssembly)</HintPath></Reference>
  </ItemGroup>
</Project>
