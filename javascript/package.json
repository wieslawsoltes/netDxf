{
  "name": "@netdxf/javascript",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Native JavaScript port of netDxf with pinned .NET differential verification (in progress)",
  "type": "module",
  "license": "MIT AND LGPL-2.1-or-later AND BSL-1.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./netDxf/*": "./netDxf/*",
    "./runtime/*": "./runtime/*",
    "./node": "./node-entry.js"
  },
  "files": [
    "netDxf",
    "runtime",
    "index.js",
    "Enums.generated.js",
    "README.md",
    "LICENSE",
    "baseline.json",
    "geometry.js",
    "native-port-manifest.json",
    "node-entry.js",
    "native/bin",
    "native/windows/atomic_replace.cc",
    "native/windows/binding.gyp",
    "native/build.mjs",
    "third_party/glibc-math",
    "tools/ReferenceMath",
    "THIRD_PARTY_NOTICES.md",
    "dimension-port-manifest.json"
  ],
  "scripts": {
    "test": "node tests/netDxf.Conformance/Program.js",
    "test:unit": "node tools/run-unit.mjs",
    "verify": "node tools/verify.mjs",
    "verify:complete": "node tools/verify.mjs --require-complete",
    "oracle": "node tools/dotnet.mjs oracle",
    "inventory": "node tools/dotnet.mjs inventory",
    "benchmark": "node tools/benchmark.mjs",
    "test:package": "node tools/package-check.mjs",
    "test:differential": "node tools/run-qualification.mjs",
    "prepublishOnly": "node tools/verify.mjs --require-complete",
    "generate:native": "node tools/dotnet.mjs native-port",
    "verify:native": "node tools/dotnet.mjs native-port --check",
    "test:geometry:exact": "node tools/geometry-stress.mjs",
    "test:foundations": "node tools/foundations-differential.mjs",
    "test:unit-factors": "node tools/unit-factors.mjs --check",
    "test:filesystem": "node tools/filesystem-differential.mjs",
    "test:hatch": "node tools/hatch-differential.mjs",
    "test:lifecycle": "node tools/lifecycle-differential.mjs",
    "build:windows-host": "node native/build.mjs",
    "test:windows-host": "node tools/run-windows-host-tests.mjs",
    "test:styles": "node tools/style-differential.mjs",
    "test:entities": "node tools/entity-differential.mjs",
    "test:browser:inline": "python tools/browser-inline-check.py",
    "test:reference-math": "node tools/reference-math-differential.mjs",
    "verify:reference-math": "python tools/ReferenceMath/generate.py --check",
    "test:math": "node tools/math-differential.mjs",
    "test:math:independent": "python tools/math-independent.py",
    "benchmark:math": "node tools/math-benchmark.mjs",
    "test:database-models": "node tools/database-model-differential.mjs",
    "test:coordinates": "node tools/coordinate-differential.mjs",
    "test:nurbs": "node tools/nurbs-differential.mjs",
    "test:exp-log": "node tools/exp-log-differential.mjs",
    "verify:exp-log": "python tools/ReferenceMath/generate-exp-log.py --check",
    "test:surfaces": "node tools/surface-differential.mjs",
    "test:attributes": "node tools/attribute-differential.mjs",
    "test:output-settings": "node tools/output-settings-differential.mjs",
    "test:groups": "node tools/group-differential.mjs",
    "test:mlines": "node tools/mline-differential.mjs",
    "test:blocks": "node tools/block-differential.mjs",
    "test:layout-viewport": "node tools/layout-viewport-differential.mjs",
    "test:geodata-vba": "node tools/geodata-vba-differential.mjs",
    "test:headers": "node tools/header-differential.mjs",
    "test:dimensions": "node tools/dimension-differential.mjs",
    "test:mleaders": "node tools/mleader-differential.mjs",
    "test:unit-formats": "node tools/unit-format-differential.mjs",
    "test:tolerances": "node tools/tolerance-differential.mjs",
    "test:leaders": "node tools/leader-differential.mjs",
    "test:observable-dictionaries": "node tools/observable-dictionary-differential.mjs",
    "test:concrete-dimensions": "node tools/concrete-dimension-differential.mjs",
    "verify:dimension-source": "node tools/dotnet.mjs native-port --dimensions --check",
    "test:object-references": "node tools/object-reference-differential.mjs",
    "test:drawing-time": "node tools/drawing-time-differential.mjs",
    "test:string-enum": "node tools/string-enum-differential.mjs",
    "test:document-ownership": "node tools/document-ownership-differential.mjs",
    "test:registered-annotations": "node tools/registered-annotations-differential.mjs",
    "test:retained-polylines": "node tools/retained-polyline-differential.mjs",
    "test:section-manager": "node tools/section-manager-differential.mjs",
    "test:table-styles": "node tools/table-style-differential.mjs",
    "test:table-geometry": "node tools/table-geometry-differential.mjs",
    "test:table-content": "node tools/table-content-differential.mjs",
    "test:stored-table": "node tools/stored-table-differential.mjs",
    "test:stored-dependencies": "node tools/stored-dependencies-differential.mjs",
    "test:codec-readers": "node tools/codec-readers-differential.mjs",
    "test:codec-writers": "node tools/codec-writers-differential.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wieslawsoltes/netDxf.git",
    "directory": "javascript"
  }
}
