<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DxfLibraryPath Condition="'$(DxfLibraryPath)' == ''">../../../../../netDxf/bin/Debug/net8.0/netDxf.netstandard.dll</DxfLibraryPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Harness.cs" />
    <Compile Include="../../../../../tests/netDxf.Conformance/SourceAmbiguityTests.cs" />
    <Reference Include="netDxf.netstandard"><HintPath>$(DxfLibraryPath)</HintPath></Reference>
  </ItemGroup>
</Project>
